# ==============================================================================
# KrishiDrishti Edge - Environment Configuration
# Project: KrishiDrishti Edge ("See. Sense. Predict. Act.")
# ==============================================================================

# Application Mode
APP_ENV=development
DEBUG=true
DEMO_MODE=true # Set to false to enable REAL HARDWARE mode

# Network & Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# AI Inference & Hardware Accelerator Mode
AI_MODE=auto # 'auto' (detects Hailo-8 or falls back to CPU), 'hailo', 'cpu'
MODEL_PATH=ai/models/crop_disease_v1.onnx
AI_CONFIDENCE_THRESHOLD=0.70
MIN_IMAGE_QUALITY_SCORE=0.60

# Camera Hardware Configuration
CAMERA_DEVICE=0 # /dev/video0 on Linux or Index 0 on Windows
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30

# Soil Sensor (RS485 Modbus-RTU) Configuration
SOIL_SENSOR_PORT=COM3 # Linux: /dev/ttyUSB0 | Windows: COM3
SOIL_SENSOR_BAUDRATE=4800
SOIL_SENSOR_SLAVE_ID=1
SOIL_SENSOR_TIMEOUT=2.0
SOIL_SENSOR_CONFIG=hardware/sensor_protocol/soil_sensor.yaml

# Logging
LOG_LEVEL=INFO

# Local Storage & Database
DATABASE_URL=sqlite:///./data/krishidrishti.db
IMAGE_STORAGE_DIR=./data/captures

# Localization
DEFAULT_LANGUAGE=en # en (English), hi (Hindi), mr (Marathi)

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SECRET_KEY=krishidrishti-local-edge-secret-key-change-in-production
